<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style for bottom navigation buttons -->
    <style name="BottomNavButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Custom styles for text elements -->
    <style name="RecipeTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Button style for primary actions -->
    <style name="PrimaryActionButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:backgroundTint">@color/primary</item>
    </style>

    <!-- Outlined variant of PrimaryActionButton -->
    <style name="PrimaryActionButton.Outlined" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- Form element styles -->
    <style name="AppSpinner" parent="Widget.AppCompat.Spinner.Underlined">
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:popupBackground">@color/surface</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:dropDownSelector">@color/surface</item>
    </style>

    <!-- Form label style -->
    <style name="FormLabel">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Custom ProgressBar style with app's secondary color -->
    <style name="AppProgressBar" parent="android:Widget.ProgressBar">
        <item name="android:indeterminateTint">@color/secondary</item>
        <item name="android:progressTint">@color/secondary</item>
    </style>

    <!-- Custom horizontal ProgressBar style -->
    <style name="AppProgressBar.Horizontal" parent="android:Widget.ProgressBar.Horizontal">
        <item name="android:indeterminateTint">@color/secondary</item>
        <item name="android:progressTint">@color/secondary</item>
    </style>
</resources>